  source_credibility: 0.0      # C：期刊/官方/标准 > 预印本 > 白皮书 > 媒体 > 未知
  evidence_strength: 0.0       # E：可复现/标准条文 > 定量数据 > 案例 > 专家观点 > 纯结论
  relevance: 0.0               # R：命中 原理+机制+指标+场景 的层数
  freshness: 0.0               # F：在该源阈值内
  transferability: 0.0         # T：跨域迁移可行性（尺度/环境/成本/成熟度）
  actionability: 0.0           # A：能否转化为论断/案例/数字
  quality_score: 0.0           # 六子项加权 final_score
  relevance_score: 0.0         # = relevance（核心论断主依据须 ≥0.70）
  confidence: "{observed | inferred | speculated}"   # 对接 three-tier-confidence

injection_use: "{它会如何影响本书的哪个论断/章节——具体到论点}"
limitations:
  - "{适用边界 1：什么场景下不成立}"
  - "{适用边界 2：证据强度/样本/迁移条件的限制}"
